# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Optional but needed for: AI advisor chat, plant scanner, lab-report extraction.
# Gemini is used by the real-time plant scanner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 to never call Open-Meteo (uses data/weather_cache or a synthetic climatology, clearly labelled).
OFFLINE_MODE=0
# Set to 1 to show a clearly labelled DEMO scanner result when no API key is configured.
SCANNER_DEMO=0
# Create demo accounts demo.tn@salinityshield.app and demo.jp@salinityshield.app (password demo1234). Set 0 in production.
SEED_DEMO=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000
